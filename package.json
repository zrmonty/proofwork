{
  "name": "proofwork",
  "version": "0.37.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "check:file-lines": "node scripts/check-file-lines.mjs --repo .",
    "check": "npm run check:source-lines && npm run context-budget && npm run check:coverage && npm run build && npm run check:file-lines",
    "context-budget": "node scripts/check-skill-list.mjs && node scripts/context-budget.mjs",
    "check:source-lines": "node scripts/check-source-lines.mjs",
    "check:coverage": "node scripts/verify-coverage.mjs",
    "build:hooks": "node scripts/build.mjs --hooks",
    "test:routing": "node --test tests/router-corpus.test.mjs tests/language-routing-corpus.test.mjs tests/language-fit.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
